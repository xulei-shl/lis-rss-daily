<%- include('layout', { pageTitle: pageTitle, pageStyles: '<link rel="stylesheet" href="/css/pages/clusters.css">' ,
  body: ` <div class="cluster-index-header">
    <div class="cluster-header-main">
      <h1 class="page-title cluster-page-title">主题洞察</h1>
      <p class="cluster-subtitle">
        对已完成总结的学术文献自动聚类，归纳研究脉络、学术共识与潜在研究空白。
      </p>
    </div>
    <div class="cluster-metrics-strip" id="overviewBar" aria-live="polite">
      <div class="skeleton-pulse skeleton-line" style="width: 280px; height: 24px; border-radius: 999px;"></div>
    </div>
  </div>

  <div class="cluster-filters-bar" role="search" aria-label="主题检索与筛选">
    <div class="search-box">
      <svg class="search-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input type="text" id="clusterSearch" class="search-input" placeholder="按主题名称、研究方法、对象或关键词过滤..." aria-label="搜索主题">
    </div>
    <div class="filter-group">
      <label for="clusterSort" class="filter-label">排序</label>
      <select id="clusterSort" class="filter-select" aria-label="排序方式">
        <option value="recent">最近更新</option>
        <option value="size">文献最多</option>
        <option value="name">主题名称</option>
      </select>
    </div>
  </div>

  <div class="results-count" id="clusterCount"></div>
  <div class="cluster-grid" id="clusterGrid"></div>
  <div class="cluster-empty" id="clusterEmpty" hidden>
    <div class="cluster-empty-title">暂无聚类主题</div>
    <div class="cluster-empty-desc">定时聚类流水线执行后将自动生成主题与多维洞察。</div>
  </div>

  <script src="/js/clusters.js"></script>
  ` }) %>
