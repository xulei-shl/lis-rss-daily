<%- include('layout', { pageTitle: pageTitle, pageStyles: '<link rel="stylesheet" href="/css/pages/search.css">', user: user, guestSummaryEnabled: guestSummaryEnabled, body:
  ` <!-- Page Header -->
  <div class="page-header">
    <h1 class="page-title">语义搜索</h1>
  </div>

  <!-- Search Box -->
  <div class="search-container">
    <div class="search-box">
      <input type="text" id="searchInput" class="search-input" placeholder="输入问题或关键词..." autocomplete="off">
      <button id="clearSearchInputBtn" class="search-clear-btn" type="button" aria-label="清空输入" style="display: none;">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <button id="searchButton" class="search-button" type="button">
        <span class="search-button-text">搜索</span>
        <span class="search-button-spinner" id="searchButtonSpinner" style="display: none;"></span>
      </button>
    </div>
    <div class="search-tips">
      <span class="search-tips-label">快捷探索：</span>
      <div class="search-tips-chips">
        <button type="button" class="search-tip-chip" data-query="LLM 在代码生成中的应用">LLM 在代码生成中的应用</button>
        <button type="button" class="search-tip-chip" data-query="多智能体系统最新进展">多智能体系统最新进展</button>
        <button type="button" class="search-tip-chip" data-query="知识图谱与检索增强生成">知识图谱与检索增强生成</button>
      </div>
    </div>
  </div>

  <!-- Results Container -->
  <div id="resultsContainer">
    <!-- Initial State -->
    <div class="empty-state" id="initialState">
      <svg class="empty-state-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
        stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <div class="empty-state-title">探索海量学术文章</div>
      <div class="empty-state-desc">
        输入关键词或具体问题，获取具备深度语义相关度的学术前沿。<br>
        支持向量召回 + JEV 语义精排；未配置 JEV 时自动回退关键词/向量排序。
      </div>
    </div>

    <!-- Loading State (Hidden) -->
    <div class="loading" id="loadingState" style="display: none;">
      <span id="loadingText">搜索中</span>
    </div>

    <!-- Results Area (Hidden) -->
    <div id="resultsArea" style="display: none;">
      <div class="results-header">
        <div class="results-count" id="resultsCount"></div>
        <div class="results-query" id="resultsQuery"></div>
      </div>
      <div id="resultsList"></div>
      <div class="pagination" id="pagination" style="display: none;"></div>
    </div>

    <!-- No Results State (Hidden) -->
    <div class="empty-state" id="noResultsState" style="display: none;">
      <svg class="empty-state-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
        stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div class="empty-state-title">未找到相关文章</div>
      <div class="empty-state-desc">
        尝试调整搜索词或使用更通用的关键词
      </div>
    </div>
  </div>

  <!-- Floating Action Dock for Batch Selection -->
  <div class="floating-action-dock" id="resultsActions" aria-live="polite">
    <div class="dock-container">
      <div class="selection-controls">
        <label class="checkbox-wrapper">
          <input type="checkbox" id="selectAll">
          <span>全选本页</span>
        </label>
        <span class="dock-divider"></span>
        <span class="selected-count">已选 <span id="selectedCount" class="count-number">0</span> 篇</span>
        <button id="clearSelectionBtn" class="btn-clear" type="button">清空已选</button>
      </div>
      <button id="aiSummaryBtn" class="btn btn-primary dock-action-btn" type="button">
        <svg class="dock-btn-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
        </svg>
        <span>AI 总结</span>
      </button>
    </div>
  </div>

  <!-- Summary Modal -->
  <div class="modal-overlay" id="summaryModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal modal-large">
      <div class="modal-header">
        <h3 id="modalTitle">AI 总结</h3>
        <button class="modal-close" id="closeSummaryModal" type="button" aria-label="关闭弹窗">×</button>
      </div>
      <div class="modal-body" id="modalBody"></div>
      <div class="modal-footer">
        <button class="btn btn-secondary" type="button" onclick="closeSummaryModal()">关闭</button>
        <button class="btn btn-primary" type="button" onclick="copySummary()">复制内容</button>
      </div>
    </div>
  </div>

  <script>
    // ============================================
    // SEARCH PAGE LOGIC
    // ============================================

    let currentQuery = '';
    let currentRerank = undefined;
    let currentPage = 1;
    let totalPages = 1;
    const perPage = 50;  // Increase to show more results per page
    let searchTimeout = null;

    // State management for article selection
    let selectedArticles = new Set();  // Cross-page selection
    let currentResults = [];  // Current page results

    // Permission check - guestSummaryEnabled from .env config
    const isLoggedIn = window.userRole !== null && window.userRole !== undefined;
    const isAdmin = window.userRole === 'admin';
    const guestSummaryEnabled = window.guestSummaryEnabled === 'true';
    // Show checkboxes if logged in OR guest summary is enabled
    const showSelectionUI = isLoggedIn || guestSummaryEnabled;
    // AI summary button only for admin or when guest summary is enabled
    const hasSummaryAccess = isAdmin || guestSummaryEnabled;
    const MAX_SELECTION = 50;

    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('searchInput');
      const searchButton = document.getElementById('searchButton');
      const clearSearchInputBtn = document.getElementById('clearSearchInputBtn');

      // Focus search input
      searchInput.focus();

      // Sync clear button visibility on load
      toggleClearButton();

      // Search on Enter
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          clearTimeout(searchTimeout);
          performSearch();
        }
      });

      // Search on button click
      searchButton.addEventListener('click', () => {
        clearTimeout(searchTimeout);
        performSearch();
      });

      // Auto-search with optimized 280ms debounce
      searchInput.addEventListener('input', () => {
        toggleClearButton();
        clearTimeout(searchTimeout);
        const query = searchInput.value.trim();

        if (query.length >= 2) {
          searchTimeout = setTimeout(() => {
            performSearch();
          }, 280);
        } else if (query.length === 0) {
          showInitialState();
        }
      });

      // Clear button interaction
      if (clearSearchInputBtn) {
        clearSearchInputBtn.addEventListener('click', () => {
          searchInput.value = '';
          toggleClearButton();
          searchInput.focus();
          showInitialState();
        });
      }

      // Quick explore chips interaction
      document.querySelectorAll('.search-tip-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          clearTimeout(searchTimeout);
          const q = chip.dataset.query || chip.textContent.trim();
          searchInput.value = q;
          toggleClearButton();
          searchInput.focus();
          performSearch();
        });
      });

      // Check for query in URL
      const urlParams = new URLSearchParams(window.location.search);
      const urlQuery = urlParams.get('q');
      if (urlQuery) {
        searchInput.value = urlQuery;
        toggleClearButton();
        performSearch();
      }

      // Setup selection controls (available for all logged in users and guest with config enabled)
      setupSelectionControls();
    });

    // Helper: toggle clear button visibility
    function toggleClearButton() {
      const searchInput = document.getElementById('searchInput');
      const clearSearchInputBtn = document.getElementById('clearSearchInputBtn');
      if (clearSearchInputBtn && searchInput) {
        clearSearchInputBtn.style.display = searchInput.value ? 'inline-flex' : 'none';
      }
    }

    // Setup selection controls
    function setupSelectionControls() {
      // Select all checkbox
      document.getElementById('selectAll').addEventListener('change', toggleSelectAll);

      // Clear selection button
      document.getElementById('clearSelectionBtn').addEventListener('click', clearSelection);

      // AI Summary button
      document.getElementById('aiSummaryBtn').addEventListener('click', generateAISummary);

      // Close modal
      document.getElementById('closeSummaryModal').addEventListener('click', closeSummaryModal);
      document.getElementById('summaryModal').addEventListener('click', (e) => {
        if (e.target.id === 'summaryModal') closeSummaryModal();
      });

      // Close modal on Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeSummaryModal();
      });
    }

    // Toggle select all
    function toggleSelectAll() {
      const selectAll = document.getElementById('selectAll');
      const checkboxes = document.querySelectorAll('.article-checkbox');
      checkboxes.forEach(cb => cb.checked = selectAll.checked);
      updateSelection();
    }

    // Update selection state (sync single checkbox with Set)
    function updateSelection() {
      const checkboxes = document.querySelectorAll('.article-checkbox');
      checkboxes.forEach(cb => {
        const id = parseInt(cb.dataset.id);
        if (cb.checked) {
          selectedArticles.add(id);
        } else {
          selectedArticles.delete(id);
        }
      });
      updateSelectionUI();
    }

    // Update selection UI (Smooth Floating Action Dock, 0 CLS)
    function updateSelectionUI() {
      const count = selectedArticles.size;
      const countEl = document.getElementById('selectedCount');
      if (countEl) countEl.textContent = count;

      const dock = document.getElementById('resultsActions');
      if (dock) {
        if (count > 0) {
          dock.classList.add('visible');
        } else {
          dock.classList.remove('visible');
        }
      }

      const aiBtn = document.getElementById('aiSummaryBtn');
      if (aiBtn) {
        aiBtn.style.display = hasSummaryAccess ? 'inline-flex' : 'none';
      }

      // Sync select all checkbox state
      const checkboxes = document.querySelectorAll('.article-checkbox');
      const allChecked = checkboxes.length > 0 && Array.from(checkboxes).every(cb => cb.checked);
      const selectAll = document.getElementById('selectAll');
      if (selectAll) {
        selectAll.checked = allChecked;
      }
    }

    // Clear selection
    function clearSelection() {
      selectedArticles.clear();
      const checkboxes = document.querySelectorAll('.article-checkbox');
      checkboxes.forEach(cb => cb.checked = false);
      const selectAll = document.getElementById('selectAll');
      if (selectAll) selectAll.checked = false;
      updateSelectionUI();
    }

    // Generate AI summary
    async function generateAISummary() {
      const ids = Array.from(selectedArticles);
      if (ids.length > MAX_SELECTION) {
        showToast(\`最多选择 \${MAX_SELECTION} 篇文章\`, 'error');
        return;
      }

      // Show loading in modal
      document.getElementById('modalBody').innerHTML = '<div class="loading">生成中...</div>';
      openSummaryModal();

      try {
        const res = await fetch('/api/search/summary', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ articleIds: ids })
        });
        const data = await res.json();

        if (res.ok) {
          renderSummaryInModal(data);
        } else {
          document.getElementById('modalBody').innerHTML = \`
            <div class="empty-state">
              <div class="empty-state-title">生成失败</div>
              <div class="empty-state-desc">\${escapeHtml(data.error || '未知错误')}</div>
            </div>
          \`;
        }
      } catch (err) {
        console.error('Failed to generate summary:', err);
        document.getElementById('modalBody').innerHTML = \`
          <div class="empty-state">
            <div class="empty-state-title">生成失败</div>
            <div class="empty-state-desc">请稍后重试</div>
          </div>
        \`;
      }
    }

    // Render summary in modal
    function renderSummaryInModal(data) {
      const summary = data.summary || '';
      const articlesByType = data.articlesByType || { journal: [], blog: [], news: [] };

      // Build full content for copy
      let fullContent = summary + '\\n\\n## 文章列表\\n\\n';
      ['journal', 'blog', 'news', 'email'].forEach(type => {
        const articles = articlesByType[type] || [];
        if (articles.length === 0) return;

        const labels = { journal: '期刊精选', blog: '博客推荐', news: '资讯动态' };
        fullContent += \`### \${labels[type]}\\n\`;
        articles.forEach((article, index) => {
          fullContent += \`\${index + 1}. [\${article.title}](\${article.url}) - \${article.source_name}\\n\`;
        });
        fullContent += '\\n';
      });

      // Render markdown
      const html = renderMarkdown(summary);

      // Build articles list HTML
      let articlesHtml = '';
      ['journal', 'blog', 'news'].forEach(type => {
        const articles = articlesByType[type] || [];
        if (articles.length === 0) return;

        const labels = { journal: '期刊精选', blog: '博客推荐', news: '资讯动态' };
        articlesHtml += \`
          <div class="articles-subsection">
            <h4 class="articles-subsection-title">\${labels[type]}</h4>
            <ul class="articles-list">
              \${articles.map(article => \`
                <li class="articles-list-item">
                  <a href="\${escapeHtml(article.url)}" target="_blank" rel="noopener" class="article-link">
                    \${escapeHtml(article.title)}
                  </a>
                  <span class="article-source">\${escapeHtml(article.source_name)}</span>
                </li>
              \`).join('')}
            </ul>
          </div>
        \`;
      });

      document.getElementById('modalBody').innerHTML = \`
        <div class="summary-detail">
          <div class="summary-detail-content" data-full-content="\${escapeHtml(fullContent)}">
            \${html}
            \${articlesHtml ? \`<div class="summary-articles-section">\${articlesHtml}</div>\` : ''}
          </div>
        </div>
      \`;
    }

    // Render markdown
    function renderMarkdown(text) {
      if (!text) return '';

      let html = escapeHtml(text);

      // Headers
      html = html.replace(/^### (.*$)/gim, '<h3>$1</h3>');
      html = html.replace(/^## (.*$)/gim, '<h2>$1</h2>');
      html = html.replace(/^# (.*$)/gim, '<h1>$1</h1>');

      // Lists
      html = html.replace(/^- (.*$)/gim, '<li>$1</li>');
      html = html.replace(/(<li>.*<\\/li>)/s, '<ul>$1</ul>');

      // Bold
      html = html.replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>');

      // Paragraphs
      html = html.split('\\n\\n').map(p => {
        if (p.startsWith('<h') || p.startsWith('<ul')) return p;
        if (!p.trim()) return '';
        return '<p>' + p.replace(/\\n/g, '<br>') + '</p>';
      }).join('');

      return html;
    }

    // Open summary modal
    function openSummaryModal() {
      const modal = document.getElementById('summaryModal');
      if (modal) modal.classList.add('active');
      document.body.classList.add('modal-open');
    }

    // Close summary modal
    function closeSummaryModal() {
      const modal = document.getElementById('summaryModal');
      if (modal) modal.classList.remove('active');
      document.body.classList.remove('modal-open');
    }

    // Copy summary (with fallback for non-secure contexts)
    async function copySummary() {
      const contentEl = document.querySelector('.summary-detail-content');
      const textToCopy = contentEl?.dataset.fullContent || contentEl?.innerText || '';

      if (!textToCopy) return;

      // Try modern clipboard API first
      if (navigator.clipboard && window.isSecureContext) {
        try {
          await navigator.clipboard.writeText(textToCopy);
          showToast('已复制到剪贴板', 'success');
          return;
        } catch (err) {
          console.error('Clipboard API failed:', err);
        }
      }

      // Fallback to older method
      try {
        const textarea = document.createElement('textarea');
        textarea.value = textToCopy;
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        const successful = document.execCommand('copy');
        document.body.removeChild(textarea);

        if (successful) {
          showToast('已复制到剪贴板', 'success');
        } else {
          showToast('复制失败，请重试', 'error');
        }
      } catch (err) {
        console.error('Copy fallback failed:', err);
        showToast('复制失败，请重试', 'error');
      }
    }

    // Show toast notification
    function showToast(message, type = 'info') {
      if (window.toast) {
        window.toast[type](message);
      } else {
        alert(message);
      }
    }

    // Toggle searching visual state (breathing list, button spinner)
    function setSearchingState(isSearching) {
      const searchButton = document.getElementById('searchButton');
      const buttonText = searchButton?.querySelector('.search-button-text');
      const spinner = document.getElementById('searchButtonSpinner');
      const resultsArea = document.getElementById('resultsArea');

      if (isSearching) {
        if (buttonText) buttonText.textContent = '检索中';
        if (spinner) spinner.style.display = 'inline-block';
        if (resultsArea) resultsArea.classList.add('is-searching');
      } else {
        if (buttonText) buttonText.textContent = '搜索';
        if (spinner) spinner.style.display = 'none';
        if (resultsArea) resultsArea.classList.remove('is-searching');
      }
    }

    // Perform search
    async function performSearch(page = 1) {
      clearTimeout(searchTimeout);
      const searchInput = document.getElementById('searchInput');
      const query = searchInput.value.trim();

      if (!query) {
        showInitialState();
        return;
      }

      currentQuery = query;
      currentPage = page;

      // Update URL without reloading
      const url = new URL(window.location);
      url.searchParams.set('q', query);
      if (page > 1) url.searchParams.set('page', page);
      window.history.replaceState({}, '', url);

      // Check if we already have visible results to prevent layout thrashing/flash
      const resultsArea = document.getElementById('resultsArea');
      const hasExistingResults = resultsArea && resultsArea.style.display !== 'none' && currentResults.length > 0;

      if (hasExistingResults) {
        setSearchingState(true);
      } else {
        const loadingMessage = page > 1 ? '加载中...' : '深度检索中...';
        showLoading(loadingMessage);
      }

      try {
        const params = new URLSearchParams({
          q: query,
          page: currentPage,
          limit: perPage
        });

        const res = await fetch(\`/api/search?\${params}\`, { credentials: 'same-origin' });
        const data = await res.json();

        setSearchingState(false);
        if (data.results && data.results.length > 0) {
          showResults(data);
        } else {
          showNoResults();
        }
      } catch (err) {
        console.error('Search failed:', err);
        setSearchingState(false);
        showNoResults();
      }
    }

// Show initial state
function showInitialState() {
  hideAllStates();
  document.getElementById('initialState').style.display = 'block';
  clearSelection();
}

// Show loading state
function showLoading(message = '搜索中...') {
  hideAllStates();
  document.getElementById('loadingText').textContent = message;
  document.getElementById('loadingState').style.display = 'block';
}

// Show results
function showResults(data) {
  hideAllStates();
  currentResults = data.results || [];
  currentRerank = data.rerank;
  const resultsArea = document.getElementById('resultsArea');
  resultsArea.style.display = 'block';

  // Update results count with tabular-nums
  const total = data.total || data.results.length;
  document.getElementById('resultsCount').innerHTML =
    \`找到 <span class="count-highlight tabular-nums">\${total}</span> 篇相关文章\`;

  // Update query display
  document.getElementById('resultsQuery').innerHTML =
    \`搜索 <em>"\${escapeHtml(currentQuery)}"</em>\`;

  // Render results
  const resultsList = document.getElementById('resultsList');
  resultsList.innerHTML = data.results.map((result, index) =>
    renderSearchResult(result, index)
  ).join('');

  // Restore selection UI state after rendering
  if (showSelectionUI) {
    updateSelectionUI();
  }

  // Update pagination
  totalPages = Math.ceil((data.total || data.results.length) / perPage);
  renderPagination();
}

// Show no results
function showNoResults() {
  hideAllStates();
  document.getElementById('noResultsState').style.display = 'block';
  clearSelection();
}

// Hide all states
function hideAllStates() {
  document.getElementById('initialState').style.display = 'none';
  document.getElementById('loadingState').style.display = 'none';
  document.getElementById('resultsArea').style.display = 'none';
  document.getElementById('noResultsState').style.display = 'none';
}

// Render single search result
function renderSearchResult(result, index) {
  const isRanked = result.ranked !== false;
  const relevance = result.relevance || result.score || 0;
  const scorePercent = Math.round(relevance * 100);

  let scoreClass = 'low';
  if (scorePercent >= 70) scoreClass = 'high';
  else if (scorePercent >= 30) scoreClass = 'medium';

  const scoreTitle = !isRanked
    ? '未经过 JEV 语义判分，按向量相似度排序'
    : (currentRerank === 'jev' ? 'JEV 语义相关性评分' : '综合相关度评分');
  const badgeHtml = isRanked
    ? '<div class="relevance-score ' + scoreClass + '" title="' + scoreTitle + '">相关度 <span class="tabular-nums">' + scorePercent + '%</span></div>'
    : '<div class="relevance-score unranked" title="' + scoreTitle + '">未判分</div>';

  // Highlight matching terms in title and excerpt
  const highlightedTitle = highlightTerms(result.title, currentQuery);
  const highlightedExcerpt = highlightTerms(
    result.excerpt || result.summary || '',
    currentQuery
  );

  // 根据来源类型确定来源名称
  let sourceName = 'Unknown';
  if (result.source_origin === 'journal') {
    sourceName = result.journal_name || 'Unknown';
  } else if (result.source_origin === 'keyword') {
    sourceName = result.keyword_name || 'Unknown';
  } else if (result.source_origin === 'email') {
    sourceName = result.source_name || '邮件订阅';
  } else {
    sourceName = result.rss_source_name || 'Unknown';
  }

  // Checkbox state (show for logged in users or guest with config enabled)
  const checked = selectedArticles.has(result.id) ? 'checked' : '';
  const checkboxHtml = showSelectionUI ? \`
    <label class="checkbox-label" title="选择文章">
      <input type="checkbox" class="article-checkbox" data-id="\${result.id}" \${checked} onchange="updateSelection()">
    </label>
  \` : '';

  // Stagger animation strictly capped to first 6 items (< 220ms total), remaining items show immediately
  const staggerDelay = Math.min(index, 6) * 35;

  return \`
    <article class="search-result fade-in-up" style="animation-delay: \${staggerDelay}ms">
      <div class="search-result-header">
        <div class="search-result-header-left">
          \${checkboxHtml}
          <h3 class="search-result-title">
            <a href="/articles/\${result.id}">\${highlightedTitle}</a>
          </h3>
        </div>
        \${badgeHtml}
      </div>
      <div class="search-result-meta">
        <span class="source-tag">\${escapeHtml(sourceName)}</span>
        <span class="meta-dot">·</span>
        <span class="meta-time">\${formatTime(result.published_at)}</span>
        <span class="meta-dot">·</span>
        <a href="\${escapeHtml(result.url)}" target="_blank" rel="noopener" class="meta-link">查看原文 ↗</a>
      </div>
      \${highlightedExcerpt ? \`<div class="search-result-excerpt">\${highlightedExcerpt}</div>\` : ''}
      \${result.tags ? \`
        <div class="search-result-tags">
          \${result.tags.split(',').slice(0, 5).map(tag =>
            \`<span class="search-result-tag">#\${escapeHtml(tag.trim())}</span>\`
          ).join('')}
        </div>
      \` : ''}
    </article>
  \`;
}

// Highlight search terms safely (support Chinese characters and avoid destroying HTML entities)
function highlightTerms(text, query) {
  if (!text) return '';
  if (!query) return escapeHtml(text);

  // Split query into distinct keywords (support single Chinese character or 2+ chars for ascii)
  const terms = query.trim().split(/\\s+/).filter(t => {
    return /[\\u4e00-\\u9fa5]/.test(t) ? t.length >= 1 : t.length >= 2;
  });

  if (terms.length === 0) return escapeHtml(text);

  // Sort terms by length descending to match longest substring first
  terms.sort((a, b) => b.length - a.length);

  const pattern = new RegExp(\`(\${terms.map(t => escapeRegex(t)).join('|')})\`, 'gi');

  // Split raw text first, escape each chunk, and mark matched keywords safely
  const parts = text.split(pattern);
  return parts.map(part => {
    if (!part) return '';
    const isMatch = terms.some(t => t.toLowerCase() === part.toLowerCase());
    return isMatch ? \`<mark>\${escapeHtml(part)}</mark>\` : escapeHtml(part);
  }).join('');
}

// Escape special regex characters
function escapeRegex(str) {
  return str.replace(/[.*+?^$()|[\\]\\\\]/g, '\\\\$&');
}

// Render pagination
function renderPagination() {
  const pagination = document.getElementById('pagination');

  if (totalPages <= 1) {
    pagination.style.display = 'none';
    return;
  }

  pagination.style.display = 'flex';

  let html = '';

  // Previous
  html += currentPage > 1
    ? \`<a href="#" onclick="goToPage(\${currentPage - 1}); return false;">← 上一页</a>\`
    : '<span>← 上一页</span>';

  // Page numbers
  const startPage = Math.max(1, currentPage - 2);
  const endPage = Math.min(totalPages, currentPage + 2);

  if (startPage > 1) {
    html += '<a href="#" onclick="goToPage(1); return false;">1</a>';
    if (startPage > 2) html += '<span>...</span>';
  }

  for (let i = startPage; i <= endPage; i++) {
    if (i === currentPage) {
      html += \`<span class="current">\${i}</span>\`;
    } else {
      html += \`<a href="#" onclick="goToPage(\${i}); return false;">\${i}</a>\`;
    }
  }

  if (endPage < totalPages) {
    if (endPage < totalPages - 1) html += '<span>...</span>';
    html += \`<a href="#" onclick="goToPage(\${totalPages}); return false;">\${totalPages}</a>\`;
  }

  // Next
  html += currentPage < totalPages
    ? \`<a href="#" onclick="goToPage(\${currentPage + 1}); return false;">下一页 →</a>\`
    : '<span>下一页 →</span>';

  pagination.innerHTML = html;
}

// Go to page
function goToPage(page) {
  currentPage = page;
  performSearch(page);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// Utility functions
function escapeHtml(str) {
  if (!str) return '';
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

function formatTime(dateStr) {
  if (!dateStr) return '';
  const date = new Date(dateStr);
  const now = new Date();
  const diff = now - date;

  if (diff < 60000) return '刚刚';
  if (diff < 3600000) return \`\${Math.floor(diff / 60000)} 分钟前\`;
  if (diff < 86400000) return \`\${Math.floor(diff / 3600000)} 小时前\`;

  return date.toLocaleDateString('zh-CN', {
    month: 'short',
    day: 'numeric',
    year: date.getFullYear() !== now.getFullYear() ? 'numeric' : undefined
  });
}
