<div class="settings-tabs">
  <div class="settings-tab-group expanded" data-group="sources">
    <div class="settings-tab-group-header" data-group="sources">
      <span class="settings-tab-group-label">数据源</span>
      <span class="settings-tab-group-arrow">▾</span>
    </div>
    <div class="settings-tab-group-body">
      <button class="settings-tab active" data-tab="rss">RSS 订阅源</button>
      <button class="settings-tab" data-tab="journals">期刊管理</button>
      <button class="settings-tab" data-tab="gmail">邮件订阅</button>
      <button class="settings-tab" data-tab="keywords">关键词订阅</button>
    </div>
  </div>

  <div class="settings-tab-group" data-group="ai">
    <div class="settings-tab-group-header" data-group="ai">
      <span class="settings-tab-group-label">AI 配置</span>
      <span class="settings-tab-group-arrow">▾</span>
    </div>
    <div class="settings-tab-group-body collapsed">
      <button class="settings-tab" data-tab="llm">LLM 配置</button>
      <button class="settings-tab" data-tab="prompts">系统提示词</button>
      <button class="settings-tab" data-tab="blacklist">黑名单</button>
    </div>
  </div>

  <div class="settings-tab-group" data-group="notify">
    <div class="settings-tab-group-header" data-group="notify">
      <span class="settings-tab-group-label">通知</span>
      <span class="settings-tab-group-arrow">▾</span>
    </div>
    <div class="settings-tab-group-body collapsed">
      <button class="settings-tab" data-tab="telegram">Telegram 通知</button>
      <button class="settings-tab" data-tab="wechat">企业微信推送</button>
    </div>
  </div>

  <div class="settings-tab-group" data-group="maintenance">
    <div class="settings-tab-group-header" data-group="maintenance">
      <span class="settings-tab-group-label">维护</span>
      <span class="settings-tab-group-arrow">▾</span>
    </div>
    <div class="settings-tab-group-body collapsed">
      <button class="settings-tab" data-tab="chroma">Chroma 设置</button>
      <button class="settings-tab" data-tab="maintenance">维护管理</button>
    </div>
  </div>
</div>

<%- include('panel-rss') %>
<%- include('panel-journals') %>
<%- include('panel-gmail') %>
<%- include('panel-keywords') %>
<%- include('panel-llm') %>
<%- include('panel-prompts') %>
<%- include('panel-blacklist') %>
<%- include('panel-telegram') %>
<%- include('panel-wechat') %>
<%- include('panel-chroma') %>
<%- include('panel-maintenance') %>
<%- include('modals') %>

<script src="/js/settings.js"></script>
<script src="/js/wechat-settings.js"></script>
<script>
// 加载主题领域列表，供所有源表单的下拉框使用
let topicDomains = [];

async function loadTopicDomains() {
  try {
    const res = await fetch('/api/topic-domains', { cache: 'no-store' });
    if (!res.ok) throw new Error('Failed to load topic domains');
    const data = await res.json();
    topicDomains = data.domains || [];

    // 领域列表加载完成后，重新渲染可能已提前加载的表格
    // （RSS 订阅源和期刊列表在 settings.js 加载时立即请求，
    //   那时 topicDomains 可能尚未就绪，导致 getDomainName() 返回 '-'）
    if (typeof renderTable === 'function') renderTable();
    if (typeof renderJournalsTable === 'function') renderJournalsTable();
    // 邮件订阅源列表（由 panel-gmail.ejs 内联脚本在 DOMContentLoaded 时加载）
    if (typeof loadGmailSources === 'function') {
      loadGmailSources();
    }
  } catch (err) {
    console.error('加载主题领域失败:', err);
  }
}

function renderDomainSelect(selectId, selectedDomainId) {
  const select = document.getElementById(selectId);
  if (!select) return;
  select.innerHTML = '<option value="">请选择领域</option>';
  for (const d of topicDomains) {
    const opt = document.createElement('option');
    opt.value = d.id;
    opt.textContent = d.name;
    if (selectedDomainId && d.id === selectedDomainId) opt.selected = true;
    select.appendChild(opt);
  }
}

function getDomainName(domainId) {
  const d = topicDomains.find(d => d.id === domainId);
  return d ? d.name : '-';
}

document.addEventListener('DOMContentLoaded', loadTopicDomains);

// 二级折叠导航 — 点击组标题切换展开/折叠
document.querySelectorAll('.settings-tab-group-header').forEach(header => {
  header.addEventListener('click', () => {
    const group = header.closest('.settings-tab-group');
    const wasExpanded = group.classList.contains('expanded');

    // 折叠所有其他组
    document.querySelectorAll('.settings-tab-group').forEach(g => {
      g.classList.remove('expanded');
      g.querySelector('.settings-tab-group-body').classList.add('collapsed');
    });

    // 展开点击的组
    if (!wasExpanded) {
      group.classList.add('expanded');
      group.querySelector('.settings-tab-group-body').classList.remove('collapsed');
    }
  });
});
</script>