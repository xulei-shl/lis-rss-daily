<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="/images/logo.png">
  <title><%= pageTitle %></title>

  <!-- Google Fonts Preload -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Main CSS Bundle -->
  <% if (process.env.NODE_ENV === 'production') { %>
    <link rel="stylesheet" href="/css/main.bundle.min.css">
  <% } else { %>
    <link rel="stylesheet" href="/css/main.css">
  <% } %>

  <script src="/js/time-utils.js"></script>

  <!-- User Role Data - defined early for JS access -->
  <script>
    window.userRole = <%- user ? `"${user.role}"` : 'null' %>;
    window.guestSummaryEnabled = <%- (typeof guestSummaryEnabled !== 'undefined' ? (guestSummaryEnabled ? '"true"' : '"false"') : '"false"') %>;
  </script>
  <!-- Page-Specific Styles -->
  <%- pageStyles %>
</head>
<body>
  <a href="#main-content" class="skip-link">跳转到内容</a>
  <header class="site-header">
    <a href="/"><img src="/images/logo.png" alt="Logo" class="logo"> LIS-RSS Literature Tracker</a>
    <nav class="site-nav">
      <% if (user) { %>
        <a href="/">首页</a>
        <a href="/articles">文章</a>
        <a href="/history">总结</a>
        <a href="/search">搜索</a>
        <a href="/deepsearch">深度检索</a>
        <a href="/filter-logs">日志</a>
        <% if (user.role === 'admin') { %>
          <a href="/settings">设置</a>
          <a href="/topics">主题</a>
        <% } %>
        <form method="POST" action="/logout" style="display: inline;">
          <button type="submit" class="btn-icon">登出</button>
        </form>
      <% } else { %>
        <a href="/login">登录</a>
      <% } %>
    </nav>
  </header>

  <main id="main-content" class="page-body">
    <%- body %>
  </main>

  <!-- Common JavaScript Components -->
  <script src="/js/confirm-dialog.js"></script>
  <script src="/js/toast.js"></script>
  <script src="/js/keyboard-shortcuts.js"></script>

  <!-- Keyboard Shortcuts Hint -->
  <div style="position: fixed; bottom: var(--space-4); right: var(--space-4); z-index: 900;">
    <button onclick="window.shortcuts?.showHelp()" class="btn-icon" style="background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius-md); padding: var(--space-2) var(--space-3); font-size: var(--text-base); color: var(--text-secondary); cursor: pointer; box-shadow: var(--shadow-sm); transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); display: inline-flex; align-items: center; justify-content: center; height: auto; min-height: 32px; line-height: 1;" title="快捷键" onmouseenter="this.style.transform='translateY(-1px)';this.style.boxShadow='var(--shadow-md)';this.style.color='var(--text-primary)'" onmouseleave="this.style.transform='translateY(0)';this.style.boxShadow='var(--shadow-sm)';this.style.color='var(--text-secondary)'">
      ⌨️
    </button>
  </div>
</body>
</html>
