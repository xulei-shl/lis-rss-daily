# LIS-RSS -> LIS-WIKI 同步配置
# 复制为 .env 后按部署环境修改；未配置项使用脚本内默认值。

# 上游数据库（只读）
LIS_RSS_DB_PATH=/opt/lis-rss-daily/data/rss-tracker.db

# 下游数据库与 PDF 根目录
WIKI_DB_PATH=/opt/lis-wiki/data/lis_wiki.db
# 必须与 LIS-WIKI 的 SOURCE_PDF_DIR 完全一致
WIKI_PDF_ROOT=/opt/lis-wiki/data/pdfs

# paper-pdf-summary 的每日暂存根目录（daily/ 会进入 wiki，manual/ 不会）
SYNC_STAGING_ROOT=/opt/lis-rss-daily/scripts/paper-pdf-summary/pdf_staging

# 无条件白名单：命中文章不论 ai_summary 是否有值都同步
JOURNALS_LIST_PATH=/opt/lis-rss-daily/scripts/lis-wiki/journals_list.yaml

# 摘要白名单：命中文章只有在 ai_summary 非空时才同步
SUMMARY_JOURNALS_LIST_PATH=/opt/lis-rss-daily/scripts/lis-wiki/journals_summary_list.yaml

# 5 天周期锚点；上线后不要修改
SYNC_ANCHOR_DATE=1970-01-01

# 每日同步上限（正常为 3）
SYNC_BATCH_SIZE=3

# 历史补录单批条数
BACKFILL_BATCH_SIZE=200

# 总开关
SYNC_ENABLED=true

# 数据库提交成功后是否删除暂存 PDF（调试时可设为 false）
SYNC_DELETE_SOURCE_AFTER_SUCCESS=true
